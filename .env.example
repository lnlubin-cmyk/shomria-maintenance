# =====================================================================
# AI maintenance advice (optional feature).
# Set these in Vercel → Project → Settings → Environment Variables.
# Leave them unset and the "ייעוץ AI" panel simply shows "not configured".
#
# Pick ONE provider, its model, and its matching key. Choose a
# VISION-CAPABLE model so photo attachments work.
# =====================================================================

# anthropic | openai | google
AI_PROVIDER=anthropic

# Model id for the chosen provider, e.g.:
#   anthropic: claude-haiku-4-5   (or claude-sonnet-4-5)
#   openai:    gpt-4o-mini
#   google:    gemini-2.0-flash
AI_MODEL=claude-haiku-4-5

# The key for the chosen provider (set only the one you use):
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# Optional: point at an OpenAI-compatible endpoint (e.g. OpenRouter).
# AI_BASE_URL=

# Note: the Supabase and other required variables already live in .env.local.
